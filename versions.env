# Single source of truth for Silver River's system-level dependency pins.
#
# Sourced by the Docker build and the benchmark suite runner. Every pin
# here is also in the image's /bench/manifest.json, so a result file
# always records what actually ran -- comparing a CPU box against a GPU box is
# only meaningful if the software stack was identical.
#
# Python-level dependencies are NOT here. They live in pyproject.toml, pinned
# by uv.lock.

# --- Base image ---
UBUNTU_TAG=24.04

# --- Godot ---
GODOT_VERSION=4.7.2
GODOT_RELEASE=stable

# --- .NET ---
DOTNET_SDK=8.0

# --- Python / harness ---
PYTHON_VERSION=3.14
UV_VERSION=0.12.11

# --- Local RTMP sink ---
# For benchmarking
MEDIAMTX_TAG=1.21.1

# --- OBS Studio ---
# ppa:obsproject/obs-studio publishes only a moving "latest" per Ubuntu series --
# there are no older versions to pin against. Empty means "whatever
# the PPA has today". Before starting a benchmarking, pin this to an
# exact apt version string (e.g. obs-studio=30.2.3-0obsproject1~noble) so every
# box in the benchmark gets the same OBS
OBS_APT_VERSION=

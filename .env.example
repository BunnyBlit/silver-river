# Per-run, per-machine configuration. Copy to .env and edit.
#
#   cp .env.example .env
#
# Docker Compose auto-loads .env; versions.env is sourced by the suite runner.

# obs-websocket password. Any value works for a local sink, this only matters
# when the box is reachable from the outside
OBS_WS_PASSWORD=changeme

# Names this run in the result filenames (<label>_<timestamp>.json/.csv),
# for ex: hetzner-cpx11_<timestamp>.json 
LABEL=local-cpu

# Sampling duration in seconds. 300 is a smoke test; sustained-load problems
# (thermal throttling, memory creep, encoder drift) need hours, not minutes.
DURATION=300
